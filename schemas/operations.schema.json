{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-relay://schemas/operations.schema.json",
  "title": "Harness Relay operations description",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationsVersion", "schemas", "operations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "operationsVersion": { "const": "1.0" },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "const": "1.0" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "operations": { "type": "array", "items": { "type": "object" } }
  }
}
